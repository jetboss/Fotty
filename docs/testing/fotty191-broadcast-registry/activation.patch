+      const end = rawEnd(tag.name, offset);
+      if (!end) return false;
+      offset = end.end;
+    } else if (!voidTags.has(tag.name)) {
+      if (stack.length >= 256) return false;
+      stack.push({ name: tag.name, hidden });
+    }
+  }
+  return stack.length === 0 && ids.size === 1 ? [...ids][0] : null;
