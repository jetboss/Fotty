+    func testReviewedFoxManifestAdmissionPreservesOpaqueQueryAndRemainsAtomic() throws {
+        let (delivery, profile) = try reviewedFoxProfile()
+        let child = URL(string: "http://77.72.19.131/iptv/abcdefghijklmn/123/ABCdef0123456789.ts?md5=fixture%2Bvalue%3D")!
+        var scoped = LocalStreamProxyPolicy(selectedMediaURL: delivery, originProfile: profile)
+        let manifest = "#EXTM3U\n#EXT-X-TARGETDURATION:10\n#EXTINF:10,\n\(child.absoluteString)"
+        let rewritten = try scoped.rewriteManifest(manifest, relativeTo: delivery, port: 8765)
+        let local = try XCTUnwrap(URL(string: rewritten.components(separatedBy: "\n").last!))
+        XCTAssertEqual(scoped.destination(for: local.path)?.absoluteString, child.absoluteString)
+        let count = scoped.registeredURLCount
+        let foreign = URL(string: "http://foreign.example/segment.ts")!
+        XCTAssertThrowsError(try scoped.rewriteManifest(manifest + "\n" + foreign.absoluteString,
+                                                       relativeTo: delivery, port: 8765))
+        XCTAssertEqual(scoped.registeredURLCount, count)
+        XCTAssertThrowsError(try scoped.admitRedirect(from: delivery, to: foreign))
+        scoped.revoke()
+        XCTAssertNil(scoped.destination(for: local.path))
+        XCTAssertThrowsError(try scoped.admitRedirect(from: delivery, to: child))
+    }
