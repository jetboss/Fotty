+    func testFoxHTTPMediaParserAcceptsFragmentedLengthAndPreservesResponseIdentity() throws {
+        let request = URLRequest(url: URL(string: "http://93.189.56.50/iptv/abcdefghijklmn/123/ABCdef0123456789.ts?md5=fixture%2Bopaque%3D")!)
+        var parser = try ReviewedFoxHTTPMediaClient.Parser(request: request, maximumBytes: 16)
+        let wire = Data("HTTP/1.1 206 Partial Content\r\nContent-Type: video/mp2t\r\nContent-Length: 5\r\nContent-Range: bytes 0-4/5\r\n\r\nhello".utf8)
+        for byte in wire { try parser.append(Data([byte])) }
+        let result = try XCTUnwrap(parser.result)
+        XCTAssertEqual(result.0, Data("hello".utf8)); XCTAssertEqual(result.1.statusCode, 206)
+        XCTAssertEqual(result.1.url?.absoluteString, request.url?.absoluteString)
+        XCTAssertEqual(result.1.value(forHTTPHeaderField: "Content-Range"), "bytes 0-4/5")
+        XCTAssertThrowsError(try parser.append(Data([0])))
+    }
