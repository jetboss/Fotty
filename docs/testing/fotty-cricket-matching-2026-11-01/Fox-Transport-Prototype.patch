+    func testActualReviewedFoxRelayUsesBoundRootAndLiteralAdvertisedSegmentWithoutCredentials() async throws {
+        let (delivery, profile) = try reviewedFoxProfile()
+        let child = URL(string: "http://77.72.23.4/iptv/abcdefghijklmn/123/ABCdef0123456789.ts?md5=fixture%2Bopaque%3D")!
+        ProxyFixtureProtocol.configure { fixture in
+            if fixture.request.url == delivery {
+                fixture.respond(type: "application/vnd.apple.mpegurl", body: Data("#EXTM3U\n\(child.absoluteString)".utf8))
+            } else { fixture.respond(type: "video/mp2t", body: Data("fixture-fox-segment".utf8)) }
+        }
+        let config = URLSessionConfiguration.ephemeral
+        config.protocolClasses = [ProxyFixtureProtocol.self]
+        let staleCookie = try XCTUnwrap(HTTPCookie(properties: [.domain: delivery.host!, .path: "/", .name: "fixture-cookie",
+            .value: "never-send-plaintext", .expires: Date().addingTimeInterval(3600)]))
+        let proxy = LocalStreamProxy(headers: [:], cookies: [staleCookie], selectedMediaURL: delivery,
+                                     originProfile: profile, configuration: config, resolver: { _ in ["8.8.8.8"] },
+                                     reviewedFoxMediaFetch: { request in
+            ProxyFixtureProtocol.recordMockedFoxMediaRequest(request)
+            return (Data("fixture-fox-segment".utf8), HTTPURLResponse(url: request.url!, statusCode: 200,
+                httpVersion: "HTTP/1.1", headerFields: ["Content-Type": "video/mp2t"])!)
+        })
+        defer { proxy.stop() }
+        try await proxy.start()
+        let localManifest = try XCTUnwrap(proxy.playbackURL())
+        let (manifest, firstResponse) = try await URLSession.shared.data(from: localManifest)
+        guard (firstResponse as? HTTPURLResponse)?.statusCode == 200 else {
+            return XCTFail("The mocked reviewed HTTP root must return a rewritten playlist")
+        }
+        let routes = String(decoding: manifest, as: UTF8.self).components(separatedBy: "\n")
+            .filter { $0.hasPrefix("http://127.0.0.1:") }
+        guard routes.count == 1 else { return XCTFail("Expected one registered segment route") }
+        let segment = try XCTUnwrap(URL(string: routes[0]))
+        let (bytes, response) = try await URLSession.shared.data(from: segment)
+        XCTAssertEqual((response as? HTTPURLResponse)?.statusCode, 200)
+        XCTAssertEqual(bytes, Data("fixture-fox-segment".utf8))
+        let requests = ProxyFixtureProtocol.requests
+        XCTAssertEqual(requests.count, 2)
+        XCTAssertEqual(requests.first?.url?.absoluteString, delivery.absoluteString)
+        XCTAssertEqual(requests.last?.url?.absoluteString, child.absoluteString)
+        for request in requests {
+            for name in ["Cookie", "Authorization", "Referer", "Origin"] {
+                XCTAssertNil(request.value(forHTTPHeaderField: name))
+            }
+        }
+        XCTAssertNil(proxy.lastFailureEvidence)
+    }
