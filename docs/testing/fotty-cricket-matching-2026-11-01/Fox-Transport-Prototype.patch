+    func testFoxHTTPMediaParserHandlesChunkExtensionsTrailersAndCloseDelimitedBody() throws {
+        let request = URLRequest(url: URL(string: "http://185.6.14.67/fixture.ts")!)
+        var chunks = try ReviewedFoxHTTPMediaClient.Parser(request: request, maximumBytes: 16)
+        let wire = Data("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3;source=fixture\r\nabc\r\n3\r\ndef\r\n0\r\nX-Fixture: complete\r\n\r\n".utf8)
+        for offset in stride(from: 0, to: wire.count, by: 3) {
+            try chunks.append(wire.subdata(in: offset..<min(wire.count, offset + 3)))
+        }
+        XCTAssertEqual(try XCTUnwrap(chunks.result).0, Data("abcdef".utf8))
+        var close = try ReviewedFoxHTTPMediaClient.Parser(request: request, maximumBytes: 16)
+        try close.append(Data("HTTP/1.0 200 OK\r\nContent-Type: video/mp2t\r\n\r\nabc".utf8))
+        XCTAssertNil(close.result); try close.finishEOF()
+        XCTAssertEqual(try XCTUnwrap(close.result).0, Data("abc".utf8))
+        var headRequest = request; headRequest.httpMethod = "HEAD"
+        var head = try ReviewedFoxHTTPMediaClient.Parser(request: headRequest, maximumBytes: 16)
+        try head.append(Data("HTTP/1.1 200 OK\r\nContent-Length: 999999\r\n\r\n".utf8))
+        XCTAssertEqual(try XCTUnwrap(head.result).0.count, 0)
