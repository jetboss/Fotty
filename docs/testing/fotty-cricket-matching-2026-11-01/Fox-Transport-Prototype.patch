+    func testReviewedFoxHTTPAuthorityIsFiniteAndCannotBeRebound() throws {
+        let (delivery, profile) = try reviewedFoxProfile()
+        XCTAssertFalse(LocalStreamProxyPolicy.allowsDestination(delivery))
+        XCTAssertFalse(LocalStreamProxyPolicy(selectedMediaURL: delivery).isValid)
+        var scoped = LocalStreamProxyPolicy(selectedMediaURL: delivery, originProfile: profile)
+        XCTAssertTrue(scoped.isValid)
+        XCTAssertTrue(scoped.admitsDestination(delivery))
+        XCTAssertNil(scoped.destination(for: "/forged/unregistered"))
+        XCTAssertFalse(profile.usesReviewedFoxHTTPMediaTransport(for: delivery), "Root metadata uses its scoped URLSession path")
+        XCTAssertFalse(scoped.admitsDestination(URL(string: "https://public.example/foreign.ts")!), "Fox cannot inherit other sources' generic HTTPS admission")
+        var noRedirect = scoped
+        XCTAssertThrowsError(try noRedirect.admitRedirect(from: delivery, to: URL(string: "https://public.example/foreign.ts")!))
+        for host in ["77.72.23.4", "77.72.19.131", "77.72.23.43", "93.189.56.50", "185.6.14.67"] {
+            let child = URL(string: "http://\(host):80/iptv/abcdefghijklmn/123/ABCdef0123456789.ts?md5=fixture%2Bopaque%3D")!
+            XCTAssertTrue(scoped.admitsDestination(child))
+            XCTAssertTrue(profile.usesReviewedFoxHTTPMediaTransport(for: child))
+            XCTAssertFalse(LocalStreamProxyPolicy.allowsDestination(child))
+        }
+        let currentFilename = URL(string: "http://93.189.56.50/iptv/abcdefghijklmn/123/ABCdef0123456.ts?md5=fixture")!
+        XCTAssertTrue(scoped.admitsDestination(currentFilename), "The freshly verified publisher uses a 13-character stem; opaque length is not channel identity")
+        let alternative = URL(string: "http://ee0c5e74.akadatel.com/iptv/abcdefghijklmn/19146/index.m3u8")!
+        XCTAssertNil(LocalStreamProxyOriginProfile.reviewedFoxCricket(deliveryURL: alternative,
+            playlistURL: URL(string: "https://raw.githubusercontent.com/time2shine/Rokon-IPTV/main/playlist.m3u")!,
+            channelID: CricketBroadcastChannel.foxCricket.canonicalID, headers: [:]), "The HD root is not qualified for this gate")
+        XCTAssertFalse(scoped.admitsDestination(alternative), "The selected root is bound, not a host-wide grant")
+        XCTAssertNil(profile.validated(for: alternative, headers: [:]))
+        XCTAssertNil(profile.validated(for: delivery, headers: ["User-Agent": "changed"]))
+        let changed = URL(string: "http://y3fqd48g.megatv.fun/iptv/abcdefghijklM2/19146/index.m3u8")!
+        XCTAssertNil(profile.validated(for: changed, headers: [:]))
+        XCTAssertFalse(LocalStreamProxyPolicy(selectedMediaURL: delivery, originProfile: profile,
+                                              requestHeaders: ["Cookie": "fixture=1"]).isValid)
+        XCTAssertFalse(LocalStreamProxyPolicy(selectedMediaURL: changed, originProfile: profile).isValid)
+    }
