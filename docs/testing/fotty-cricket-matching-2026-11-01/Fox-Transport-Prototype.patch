+                case .failed(let error): self.finish(.failure(error))
+                case .cancelled: self.finish(.failure(URLError(.networkConnectionLost)))
+                default: break
+                }
+            }
+            connection.start(queue: queue)
+        }
+
+        private func receive() {
+            guard !completion.isFinished else { return }
+            connection.receive(minimumIncompleteLength: 1, maximumLength: 32 * 1_024) { [weak self] data, _, isComplete, error in
+                guard let self, !self.completion.isFinished else { return }
+                if let error { self.finish(.failure(error)); return }
+                do {
+                    if let data { try self.parser.append(data) }
+                    if isComplete { try self.parser.finishEOF() }
+                    if let result = self.parser.result { self.finish(.success(result)) }
+                    else { self.receive() }
+                } catch { self.finish(.failure(error)) }
+            }
+        }
+
+        private func finish(_ result: Result<(Data, HTTPURLResponse), Error>) {
+            completion.finish(result)
+            cleanup()
+        }
+
+        private func cleanup() {
+            timer?.cancel()
+            timer = nil
+            connection.stateUpdateHandler = nil
+            connection.cancel()
+        }
+    }
+}
