+    testRequested: false, testRequestedAt: null, pendingTest: false, fence: 0, lease: null, retryBatch: null, day, attempts: 0, nextAt: 0,
+    lastAttemptAt: null, lastSubmittedAt: null, submittedBatches: 0, ambiguousAttempts: 0,
